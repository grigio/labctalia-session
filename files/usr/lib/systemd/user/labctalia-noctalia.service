[Unit]
Description=Noctalia shell (Labctalia)
Documentation=https://github.com/grigio/labctalia-session
PartOf=labctalia-session.target
After=labctalia-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
Slice=session.slice

# Started by labctalia-session.target (Wants=), not enabled by the user.
