#!/bin/sh
# Labctalia — a minimal labwc + Noctalia Wayland session.
# Source: https://github.com/grigio/labctalia-session
# (installed by the labctalia-session package; edit the source, not the copy
# in /usr/bin)
#
# The compositor is labwc; the shell is Noctalia. This launcher owns the
# session startup. It deliberately does NOT install or use
# ~/.config/labwc/autostart: Noctalia, the portals and the optional helpers
# are systemd user units started through labctalia-session.target.
#
# XDG session entry: /usr/share/wayland-sessions/labctalia.desktop
# systemd user target: /usr/lib/systemd/user/labctalia-session.target
#
# What runs, and nothing else:
#   labwc                           compositor, started here (it must run
#                                   before the socket and the session target)
#   labctalia-noctalia.service      bar, dock, launcher, notifications, lock
#                                   screen, idle/suspend, polkit agent, MPRIS,
#                                   screensaver; supervised by systemd
#   xdg-desktop-portal + wlr/gtk    restarted below, after the socket exists
#   labctalia-theme-sync.path       optional (enable it yourself): Noctalia
#                                   colors -> labwc window decorations
#   labctalia-gestures.service      optional (enable it yourself): 4-finger
#                                   touchpad workspace switch
# Already covered without starting anything here:
#   dbus-broker                     user bus
#   pipewire / wireplumber          socket + enabled unit (audio, screencast)
#   gnome-keyring-daemon            secret service, socket activated
#   gvfs-*, xdg-document-portal     D-Bus activated on first use, if installed
#   upower, power-profiles-daemon   system services, session agnostic

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=labctalia
export DESKTOP_SESSION=labctalia
# ":wlroots" is what makes xdg-desktop-portal-wlr's .portal file usable. The
# session also ships labctalia-portals.conf, so the backend is selected
# explicitly instead of relying on the deprecated UseIn= keys.
export XDG_CURRENT_DESKTOP=labctalia:wlroots
# Keep the user's local bin first for the apps Noctalia spawns, but resolve
# the session binaries below by absolute path so ~/.local/bin cannot shadow
# the compositor or the shell.
if [ -n "${PATH:-}" ]; then
    export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
else
    export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
fi

# Lets a personal ~/.config/labwc/autostart skip the services this session
# already owns:
#   [ -n "${LABCTALIA_SESSION:-}" ] && exit 0
export LABCTALIA_SESSION=1

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "labctalia: XDG_RUNTIME_DIR ($XDG_RUNTIME_DIR) does not exist" >&2
    echo "labctalia: start this session from a logind login, not from a bare console" >&2
    exit 1
fi
export XDG_RUNTIME_DIR

log="$XDG_RUNTIME_DIR/labctalia-session.log"
if ! : >"$log" 2>/dev/null; then
    log=/dev/null
fi

say() { echo "labctalia: $*" >>"$log"; }

comp=/usr/bin/labwc
noctalia=/usr/bin/noctalia
for bin in "$comp" "$noctalia"; do
    if [ ! -x "$bin" ]; then
        say "error: $bin is missing or not executable"
        echo "labctalia: $bin is missing or not executable, see $log" >&2
        exit 1
    fi
done

# labwc-blur provides the same binary plus ext-background-effect-v1. The
# default rc.xml ships a <blur> block; stock labwc ignores it with a warning.
if ! /usr/bin/pacman -Qq labwc-blur >/dev/null 2>&1; then
    say "note: labwc-blur is not installed; blur in the default rc.xml is ignored"
fi

# labwc reads ~/.config/labwc/environment itself and overrides variables set
# here. A stale XDG_CURRENT_DESKTOP there makes labwc's children (and Noctalia
# if it is ever launched by labwc) see a different desktop name than the
# systemd user manager, which breaks portal backend selection.
envfile="$HOME/.config/labwc/environment"
if [ -f "$envfile" ]; then
    env_desktop=$(/usr/bin/grep -E '^[[:space:]]*(export[[:space:]]+)?XDG_CURRENT_DESKTOP[[:space:]]*=' "$envfile" 2>/dev/null |
        /usr/bin/tail -n 1 | /usr/bin/sed 's/^[^=]*=//' | /usr/bin/tr -d '"' | /usr/bin/tr -d "'")
    if [ -n "$env_desktop" ] && [ "$env_desktop" != "$XDG_CURRENT_DESKTOP" ]; then
        say "warning: $envfile sets XDG_CURRENT_DESKTOP=$env_desktop"
        say "warning: labwc will use that value; remove the line or set it to $XDG_CURRENT_DESKTOP"
    fi
fi

# The package does not install an autostart file. A personal one may still
# start the same daemons twice (Noctalia, theme sync, gestures, portals).
# A file that guards those lines with LABCTALIA_SESSION (the documented
# migration) is fine; only warn when the guard is missing.
autostart="$HOME/.config/labwc/autostart"
if [ -f "$autostart" ] &&
    ! /usr/bin/grep -v '^[[:space:]]*#' "$autostart" 2>/dev/null |
        /usr/bin/grep -q 'LABCTALIA_SESSION' &&
    /usr/bin/grep -v '^[[:space:]]*#' "$autostart" 2>/dev/null |
        /usr/bin/grep -Eq 'noctalia|labwc-4finger-gestures|labctalia-|noctalia-labwc-theme-sync|xdg-desktop-portal|labwc-session\.target'; then
    say "warning: $autostart starts services this session already manages"
    say "warning: remove those lines or guard them with LABCTALIA_SESSION"
fi

# labwc picks its backend from the environment: a set DISPLAY or
# WAYLAND_DISPLAY means "nested". Leave either set and it tries to open a
# window instead of DRM/KMS. LABCTALIA_NESTED=1 is for a nested test session
# with its own user manager (the launcher still stops graphical-session.target,
# so do not run it from a terminal inside an existing desktop).
if [ -z "${LABCTALIA_NESTED:-}" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

# A previous session may have exited without stopping graphical-session.target
# (a compositor killed by logind, for example). labctalia-session.target is
# BindsTo= graphical-session.target, so starting ours would reuse the stale
# target and inherit every PartOf= unit from that session: old portals, the
# gesture helper, and so on. Tear it down before starting the new session.
if /usr/bin/systemctl --user is-active --quiet graphical-session.target; then
    say "stopping stale graphical-session.target from a previous session"
    /usr/bin/systemctl --user stop graphical-session.target >>"$log" 2>&1 || true
fi

# The COSMIC portal has no PartOf= and can survive a previous session with a
# stale WAYLAND_DISPLAY. Stop it explicitly; it is not selected by
# labctalia-portals.conf anyway.
/usr/bin/systemctl --user stop org.freedesktop.impl.portal.desktop.cosmic.service \
    >>"$log" 2>&1 || true

stamp="$XDG_RUNTIME_DIR/.labctalia-session-start"
: >"$stamp"

"$comp" >>"$log" 2>&1 &
comp_pid=$!

# labwc exports LABWC_PID for its own children; publish the same value to the
# systemd user manager and D-Bus so Noctalia (a systemd service, not a labwc
# child) can find the compositor. Noctalia uses it for logout and for
# compositor detection; labwc --reconfigure needs it too.
LABWC_PID=$comp_pid
export LABWC_PID

# On logout the session scope SIGTERMs this script, and even a plain
# "kill <script>" should not leave the shell and the portals behind.
cleanup() {
    # Stopping labctalia-session.target stops Noctalia: it is PartOf= the
    # target and has a short TimeoutStopSec. Blocking (with a timeout) gives
    # it a chance to exit before logind tears down the scope.
    /usr/bin/timeout 10 /usr/bin/systemctl --user stop labctalia-session.target \
        >>"$log" 2>&1 || true
    # xdg-desktop-portal-wlr is PartOf=graphical-session.target and has
    # ConditionEnvironment=WAYLAND_DISPLAY; stop it before the target so it
    # does not linger with a stale socket.
    /usr/bin/timeout 5 /usr/bin/systemctl --user stop xdg-desktop-portal-wlr.service \
        >>"$log" 2>&1 || true
    # The COSMIC backend has no PartOf=; stop it explicitly.
    /usr/bin/timeout 5 /usr/bin/systemctl --user stop \
        org.freedesktop.impl.portal.desktop.cosmic.service >>"$log" 2>&1 || true
    /usr/bin/timeout 10 /usr/bin/systemctl --user stop graphical-session.target \
        >>"$log" 2>&1 || true
}
trap 'cleanup; [ -n "${comp_pid:-}" ] && kill "$comp_pid" 2>/dev/null; exit 143' TERM INT HUP

# Find the socket labwc listens on (it picks wayland-N itself): Noctalia and
# everything it spawns has to be pointed at that one.
sock=""
i=0
while [ "$i" -lt 300 ] && kill -0 "$comp_pid" 2>/dev/null; do
    if [ -x /usr/bin/ss ]; then
        sock=$(/usr/bin/ss -xlHp 2>/dev/null |
            /usr/bin/awk -v p="pid=$comp_pid," 'index($0, p) && $2 == "LISTEN" {print $5; exit}')
    else
        # no iproute2: newest socket created since the compositor started
        sock=$(/usr/bin/find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' -type s \
            -newer "$stamp" -print -quit 2>/dev/null)
    fi
    if [ -n "$sock" ] && [ -S "$sock" ]; then
        break
    fi
    sock=""
    i=$((i + 1))
    sleep 0.1
done
rm -f "$stamp"

if [ -n "$sock" ]; then
    export WAYLAND_DISPLAY="${sock##*/}"

    # labwc was started without a display in its environment, so publish ours
    # for portals and other D-Bus/systemd-activated services. LABWC_PID is
    # what Noctalia looks for.
    /usr/bin/dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        DESKTOP_SESSION XDG_RUNTIME_DIR PATH LABWC_PID LABCTALIA_SESSION 2>/dev/null || true
    /usr/bin/systemctl --user import-environment \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        DESKTOP_SESSION XDG_RUNTIME_DIR PATH LABWC_PID LABCTALIA_SESSION 2>/dev/null || true

    # The package installs the session units. Reload in case the user manager
    # survived a package upgrade and still has the old unit set cached.
    /usr/bin/systemctl --user daemon-reload 2>/dev/null || true

    # Both portals are D-Bus activated and may still be running with the
    # previous session's WAYLAND_DISPLAY. Restarting them costs ~100 ms and
    # avoids a stale socket. `restart`, not `try-restart`: when the previous
    # compositor died the backend usually exited too, and try-restart ignores
    # failed units — that left the portal without a backend for the session.
    #
    # xdg-desktop-portal-wlr has ConditionEnvironment=WAYLAND_DISPLAY, so the
    # environment import above must happen first.
    for svc in xdg-desktop-portal.service xdg-desktop-portal-wlr.service; do
        /usr/bin/systemctl --user --no-block restart "$svc" >>"$log" 2>&1 || true
    done

    # labctalia-session.target pulls in labctalia-noctalia.service. systemd
    # supervises it from here on: restart on crash, journal logging, and
    # PartOf= for logout.
    if ! /usr/bin/systemctl --user start labctalia-session.target >>"$log" 2>&1; then
        say "warning: failed to start labctalia-session.target, see journalctl --user"
    fi
else
    say "compositor socket not found, not starting Noctalia"
fi

wait "$comp_pid"
status=$?
say "compositor exited with status $status"

cleanup
exit "$status"
